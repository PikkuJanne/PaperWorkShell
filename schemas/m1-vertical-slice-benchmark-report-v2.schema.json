{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworkshell.local/schemas/m1-vertical-slice-benchmark-report-v2.json",
  "title": "PaperWorkShell M1 constrained-resource report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "workload",
    "processing_profile",
    "resource_policy_version",
    "resource_limits",
    "limitations",
    "vertical_slice"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "report_kind": {"const": "m1-resource-budget-measurement"},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "m1-vertical-slice"},
        "version": {"const": 1}
      }
    },
    "processing_profile": {"enum": ["normal", "constrained"]},
    "resource_policy_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "resource_limits": {"$ref": "#/$defs/resourceLimits"},
    "limitations": {
      "type": "array",
      "prefixItems": [
        {"const": "This resource report does not certify a physical low-end hardware profile; physical low-end hardware was not tested."},
        {"const": "Peak collection samples the complete observed process-tree RSS and case-workspace usage every 50 ms; shorter transients and worker-private temporary-storage peaks may not be observed, while each worker operation enforces its configured temporary-storage limit."}
      ],
      "items": false
    },
    "vertical_slice": {"$ref": "#/$defs/verticalSlice"}
  },
  "$defs": {
    "integer": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "versionIdentity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_case_bytes",
        "maximum_cache_bytes",
        "maximum_temporary_storage_bytes",
        "maximum_source_bytes",
        "maximum_page_count",
        "worker_process_memory_bytes",
        "worker_job_memory_bytes",
        "worker_cpu_time_ms",
        "worker_maximum_processes",
        "maximum_heavy_operation_concurrency",
        "maximum_preview_request_pages",
        "preview_prefetch_radius_pages",
        "thumbnail_preview_cache_bytes",
        "maximum_preview_pixels_per_page",
        "import_io_chunk_bytes",
        "canonical_process_tree_rss_bytes",
        "minimum_export_free_space_reserve_bytes",
        "maximum_ui_heartbeat_gap_ms",
        "cancellation_acknowledgement_ms",
        "maximum_active_full_resolution_page_buffers",
        "resource_sampling_interval_ms"
      ],
      "properties": {
        "maximum_case_bytes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_cache_bytes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_temporary_storage_bytes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_source_bytes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_page_count": {"$ref": "#/$defs/positiveInteger"},
        "worker_process_memory_bytes": {"$ref": "#/$defs/positiveInteger"},
        "worker_job_memory_bytes": {"$ref": "#/$defs/positiveInteger"},
        "worker_cpu_time_ms": {"$ref": "#/$defs/positiveInteger"},
        "worker_maximum_processes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_heavy_operation_concurrency": {"$ref": "#/$defs/positiveInteger"},
        "maximum_preview_request_pages": {"$ref": "#/$defs/positiveInteger"},
        "preview_prefetch_radius_pages": {"$ref": "#/$defs/positiveInteger"},
        "thumbnail_preview_cache_bytes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_preview_pixels_per_page": {"$ref": "#/$defs/positiveInteger"},
        "import_io_chunk_bytes": {"$ref": "#/$defs/positiveInteger"},
        "canonical_process_tree_rss_bytes": {"$ref": "#/$defs/positiveInteger"},
        "minimum_export_free_space_reserve_bytes": {"$ref": "#/$defs/positiveInteger"},
        "maximum_ui_heartbeat_gap_ms": {"$ref": "#/$defs/positiveInteger"},
        "cancellation_acknowledgement_ms": {"$ref": "#/$defs/positiveInteger"},
        "maximum_active_full_resolution_page_buffers": {"$ref": "#/$defs/positiveInteger"},
        "resource_sampling_interval_ms": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "phaseMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "outcome", "elapsed_ns"],
      "properties": {
        "phase": {"enum": ["case-create", "pdf-import", "thumbnail-render", "organize", "verified-export", "case-reopen-recovery"]},
        "outcome": {"enum": ["completed", "failed"]},
        "elapsed_ns": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "workerResourceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "process_memory_limit_bytes", "job_memory_limit_bytes", "peak_process_memory_used_bytes", "peak_job_memory_used_bytes"],
      "properties": {
        "operation": {"enum": ["source-inspection", "thumbnail-render", "verified-export"]},
        "process_memory_limit_bytes": {"$ref": "#/$defs/positiveInteger"},
        "job_memory_limit_bytes": {"$ref": "#/$defs/positiveInteger"},
        "peak_process_memory_used_bytes": {"$ref": "#/$defs/positiveInteger"},
        "peak_job_memory_used_bytes": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "workspaceUsageMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "case_bytes", "cache_bytes", "temp_bytes", "entry_count", "maximum_depth_seen"],
      "properties": {
        "checkpoint": {"enum": ["created", "imported", "organized", "exported", "recovered"]},
        "case_bytes": {"$ref": "#/$defs/integer"},
        "cache_bytes": {"$ref": "#/$defs/integer"},
        "temp_bytes": {"$ref": "#/$defs/integer"},
        "entry_count": {"$ref": "#/$defs/integer"},
        "maximum_depth_seen": {"$ref": "#/$defs/integer"}
      }
    },
    "budgetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_id", "observed", "limit", "passed"],
      "properties": {
        "budget_id": {"enum": ["process-tree-rss", "cache-bytes", "temporary-storage-bytes", "heavy-operation-concurrency", "ui-heartbeat-gap", "cancellation-acknowledgement"]},
        "observed": {"$ref": "#/$defs/integer"},
        "limit": {"$ref": "#/$defs/positiveInteger"},
        "passed": {"type": "boolean"}
      }
    },
    "completedRunEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "sample_count", "total_elapsed_ns", "repository_revision", "repository_tree", "repository_worktree_clean",
        "report_schema_sha256", "fixture_set_sha256", "source_set_sha256", "python_version", "pikepdf_version", "qpdf_version",
        "pdfium_version", "qt_version", "worker_config_sha256", "renderer_profile_sha256", "manifest_schema_version",
        "worker_protocol_version", "export_profile_version", "workload_version", "source_count", "source_page_count",
        "active_page_count", "preview_count", "output_count", "output_page_count", "output_bytes", "output_sha256",
        "semantic_fingerprint", "deterministic_semantic_equal", "deterministic_output_equal", "verifier_codes", "recovery_status",
        "case_reopened", "reopened_page_count", "reopened_sequence_equal", "privacy_scan_status", "privacy_canary_count",
        "background_export_completed", "workers_terminated", "worker_recycle_policy", "low_disk_simulation_status",
        "slow_io_simulation_status", "worker_recovery_status", "heartbeat_count", "maximum_heartbeat_gap_ns", "peak_process_tree_rss_bytes",
        "peak_cache_bytes", "peak_temp_bytes", "max_heavy_operation_concurrency", "cancellation_acknowledgement_ms",
        "ui_heartbeat_violation_count", "duration_ms", "input_bytes", "budget_results"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "sample_count": {"const": 1},
        "total_elapsed_ns": {"$ref": "#/$defs/positiveInteger"},
        "repository_revision": {"$ref": "#/$defs/gitObjectId"},
        "repository_tree": {"$ref": "#/$defs/gitObjectId"},
        "repository_worktree_clean": {"const": true},
        "report_schema_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_set_sha256": {"$ref": "#/$defs/sha256"},
        "source_set_sha256": {"$ref": "#/$defs/sha256"},
        "python_version": {"$ref": "#/$defs/versionIdentity"},
        "pikepdf_version": {"$ref": "#/$defs/versionIdentity"},
        "qpdf_version": {"$ref": "#/$defs/versionIdentity"},
        "pdfium_version": {"$ref": "#/$defs/versionIdentity"},
        "qt_version": {"$ref": "#/$defs/versionIdentity"},
        "worker_config_sha256": {"$ref": "#/$defs/sha256"},
        "renderer_profile_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_schema_version": {"$ref": "#/$defs/positiveInteger"},
        "worker_protocol_version": {"$ref": "#/$defs/positiveInteger"},
        "export_profile_version": {"$ref": "#/$defs/positiveInteger"},
        "workload_version": {"const": 1},
        "source_count": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
        "source_page_count": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
        "active_page_count": {"$ref": "#/$defs/positiveInteger"},
        "preview_count": {"$ref": "#/$defs/positiveInteger"},
        "output_count": {"const": 2},
        "output_page_count": {"$ref": "#/$defs/positiveInteger"},
        "output_bytes": {"$ref": "#/$defs/positiveInteger"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_fingerprint": {"$ref": "#/$defs/sha256"},
        "deterministic_semantic_equal": {"const": true},
        "deterministic_output_equal": {"const": true},
        "verifier_codes": {
          "type": "array",
          "prefixItems": [
            {"const": "PDF_REOPENED"}, {"const": "STRUCTURE_CLEAN"}, {"const": "PAGE_COUNT_MATCHED"},
            {"const": "UNENCRYPTED"}, {"const": "ALL_PAGES_RENDERED"}, {"const": "ORDER_ROTATION_MATCHED"},
            {"const": "OUTPUT_COMMIT_REOPENED"}
          ],
          "items": false
        },
        "recovery_status": {"enum": ["current", "recovered"]},
        "case_reopened": {"const": true},
        "reopened_page_count": {"$ref": "#/$defs/positiveInteger"},
        "reopened_sequence_equal": {"const": true},
        "privacy_scan_status": {"const": "passed"},
        "privacy_canary_count": {"$ref": "#/$defs/positiveInteger"},
        "background_export_completed": {"const": true},
        "workers_terminated": {"const": true},
        "worker_recycle_policy": {"const": "one-shot"},
        "low_disk_simulation_status": {"const": "passed"},
        "slow_io_simulation_status": {"const": "passed"},
        "worker_recovery_status": {"const": "passed"},
        "heartbeat_count": {"$ref": "#/$defs/positiveInteger"},
        "maximum_heartbeat_gap_ns": {"$ref": "#/$defs/positiveInteger"},
        "peak_process_tree_rss_bytes": {"$ref": "#/$defs/positiveInteger"},
        "peak_cache_bytes": {"$ref": "#/$defs/integer"},
        "peak_temp_bytes": {"$ref": "#/$defs/integer"},
        "max_heavy_operation_concurrency": {"$ref": "#/$defs/positiveInteger"},
        "cancellation_acknowledgement_ms": {"$ref": "#/$defs/integer"},
        "ui_heartbeat_violation_count": {"$ref": "#/$defs/integer"},
        "duration_ms": {"$ref": "#/$defs/positiveInteger"},
        "input_bytes": {"$ref": "#/$defs/positiveInteger"},
        "budget_results": {
          "type": "array",
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "process-tree-rss"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "cache-bytes"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "temporary-storage-bytes"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "heavy-operation-concurrency"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "ui-heartbeat-gap"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "cancellation-acknowledgement"}}}]}
          ],
          "items": false
        }
      }
    },
    "failedRunEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "failure_stage", "total_elapsed_ns", "repository_revision", "repository_tree",
        "repository_worktree_clean", "report_schema_sha256", "budget_results"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "failure_stage": {"enum": ["setup", "workload", "budget-evaluation"]},
        "total_elapsed_ns": {"$ref": "#/$defs/positiveInteger"},
        "repository_revision": {"$ref": "#/$defs/gitObjectId"},
        "repository_tree": {"$ref": "#/$defs/gitObjectId"},
        "repository_worktree_clean": {"const": true},
        "report_schema_sha256": {"$ref": "#/$defs/sha256"},
        "budget_results": {
          "type": "array",
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "process-tree-rss"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "cache-bytes"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "temporary-storage-bytes"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "heavy-operation-concurrency"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "ui-heartbeat-gap"}}}]},
            {"allOf": [{"$ref": "#/$defs/budgetResult"}, {"properties": {"budget_id": {"const": "cancellation-acknowledgement"}}}]}
          ],
          "items": false
        }
      }
    },
    "verticalSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_status", "result_code", "phase_measurements", "worker_resource_measurements", "workspace_usage_measurements"],
      "properties": {
        "run_status": {"enum": ["not-run", "completed", "failed"]},
        "result_code": {"type": ["string", "null"], "pattern": "^M1_[A-Z0-9_]{1,96}$"},
        "phase_measurements": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/phaseMeasurement"}},
        "worker_resource_measurements": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/workerResourceMeasurement"}},
        "workspace_usage_measurements": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/workspaceUsageMeasurement"}},
        "completed_evidence": {"$ref": "#/$defs/completedRunEvidence"},
        "failed_evidence": {"$ref": "#/$defs/failedRunEvidence"}
      },
      "allOf": [
        {
          "if": {"properties": {"run_status": {"const": "not-run"}}, "required": ["run_status"]},
          "then": {
            "properties": {
              "result_code": {"const": "M1_VERTICAL_SLICE_NOT_RUN"},
              "phase_measurements": {"maxItems": 0},
              "worker_resource_measurements": {"maxItems": 0},
              "workspace_usage_measurements": {"maxItems": 0}
            },
            "allOf": [
              {"not": {"required": ["completed_evidence"]}},
              {"not": {"required": ["failed_evidence"]}}
            ]
          }
        },
        {
          "if": {"properties": {"run_status": {"const": "completed"}}, "required": ["run_status"]},
          "then": {
            "required": ["completed_evidence"],
            "properties": {
              "result_code": {"type": "null"},
              "phase_measurements": {"minItems": 6, "maxItems": 6},
              "worker_resource_measurements": {"minItems": 3, "maxItems": 3},
              "workspace_usage_measurements": {"minItems": 5, "maxItems": 5}
            },
            "not": {"required": ["failed_evidence"]}
          }
        },
        {
          "if": {"properties": {"run_status": {"const": "failed"}}, "required": ["run_status"]},
          "then": {
            "required": ["failed_evidence"],
            "not": {"required": ["completed_evidence"]}
          }
        }
      ]
    }
  }
}
