{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworkshell.local/schemas/export-history-v1.schema.json",
  "title": "PaperWorkShell export history v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/exportRecord"
      }
    }
  },
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "checkCode": {
      "enum": [
        "PDF_REOPENED",
        "STRUCTURE_CLEAN",
        "PAGE_COUNT_MATCHED",
        "UNENCRYPTED",
        "ALL_PAGES_RENDERED",
        "ORDER_ROTATION_MATCHED",
        "UNSIGNED_DERIVATIVE",
        "OUTPUT_COMMIT_REOPENED"
      ]
    },
    "exportRecord": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "unsigned_derivative": {
                "const": true
              }
            },
            "required": ["unsigned_derivative"]
          },
          "then": {
            "properties": {
              "check_codes": {
                "const": [
                  "PDF_REOPENED",
                  "STRUCTURE_CLEAN",
                  "PAGE_COUNT_MATCHED",
                  "UNENCRYPTED",
                  "ALL_PAGES_RENDERED",
                  "ORDER_ROTATION_MATCHED",
                  "UNSIGNED_DERIVATIVE",
                  "OUTPUT_COMMIT_REOPENED"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "check_codes": {
                "const": [
                  "PDF_REOPENED",
                  "STRUCTURE_CLEAN",
                  "PAGE_COUNT_MATCHED",
                  "UNENCRYPTED",
                  "ALL_PAGES_RENDERED",
                  "ORDER_ROTATION_MATCHED",
                  "OUTPUT_COMMIT_REOPENED"
                ]
              }
            }
          }
        }
      ],
      "required": [
        "export_id",
        "record_version",
        "recorded_at",
        "manifest_revision",
        "manifest_sha256",
        "semantic_fingerprint",
        "output_sha256",
        "output_byte_size",
        "page_count",
        "check_codes",
        "unsigned_derivative"
      ],
      "properties": {
        "export_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "record_version": {
          "const": 1
        },
        "recorded_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "manifest_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "check_codes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkCode"
          }
        },
        "unsigned_derivative": {
          "type": "boolean"
        }
      }
    }
  }
}
