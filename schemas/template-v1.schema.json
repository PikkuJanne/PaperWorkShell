{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworkshell.invalid/schemas/template-v1.json",
  "title": "PaperWorkShell declarative template v1",
  "description": "A closed, bounded, non-executable document-packaging template. Embedded provenance is an untrusted assertion; trust is derived externally from the exact loaded bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "template_version",
    "scope",
    "title",
    "locale",
    "provenance",
    "lifecycle",
    "instructions",
    "requirements",
    "requirement_order",
    "output",
    "warnings",
    "confirmations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template_id": {
      "$ref": "#/$defs/token"
    },
    "template_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "scope": {
      "const": "document_packaging_only"
    },
    "title": {
      "$ref": "#/$defs/shortText"
    },
    "locale": {
      "$ref": "#/$defs/locale"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/instruction"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "requirement_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "output": {
      "$ref": "#/$defs/outputPolicy"
    },
    "warnings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "confirmations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/confirmation"
      }
    }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calendarDate": {
      "type": "string",
      "format": "date",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "plainText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "safeStaticStem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": {
        "enum": [
          "aux",
          "clock",
          "con",
          "conin",
          "conout",
          "nul",
          "prn",
          "com1",
          "com2",
          "com3",
          "com4",
          "com5",
          "com6",
          "com7",
          "com8",
          "com9",
          "lpt1",
          "lpt2",
          "lpt3",
          "lpt4",
          "lpt5",
          "lpt6",
          "lpt7",
          "lpt8",
          "lpt9"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "publisher",
        "source_reference",
        "source_url",
        "source_document_sha256",
        "assertion_status",
        "trust_policy"
      ],
      "properties": {
        "source_kind": {
          "enum": ["built_in", "community", "local"]
        },
        "publisher": {
          "$ref": "#/$defs/shortText"
        },
        "source_reference": {
          "$ref": "#/$defs/token"
        },
        "source_url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/httpsUrl"
            }
          ]
        },
        "source_document_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "assertion_status": {
          "const": "untrusted_embedded_claims"
        },
        "trust_policy": {
          "const": "external_verification_required"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_on", "review_due_on", "expires_on"],
      "properties": {
        "verified_on": {
          "$ref": "#/$defs/calendarDate"
        },
        "review_due_on": {
          "$ref": "#/$defs/calendarDate"
        },
        "expires_on": {
          "$ref": "#/$defs/calendarDate"
        }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_id", "text"],
      "properties": {
        "instruction_id": {
          "$ref": "#/$defs/token"
        },
        "text": {
          "$ref": "#/$defs/plainText"
        }
      }
    },
    "requirementCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "minimum", "maximum"],
      "properties": {
        "unit": {
          "enum": ["documents", "pages"]
        },
        "minimum": {
          "$ref": "#/$defs/safeInteger"
        },
        "maximum": {
          "$ref": "#/$defs/positiveSafeInteger"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "title", "guidance", "count"],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/token"
        },
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "guidance": {
          "$ref": "#/$defs/plainText"
        },
        "count": {
          "$ref": "#/$defs/requirementCount"
        }
      }
    },
    "outputLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_file_count",
        "maximum_total_bytes",
        "maximum_file_bytes",
        "maximum_pages_per_file"
      ],
      "properties": {
        "maximum_file_count": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "maximum_total_bytes": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "maximum_file_bytes": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "maximum_pages_per_file": {
          "$ref": "#/$defs/positiveSafeInteger"
        }
      }
    },
    "requirementStem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "stem"],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/token"
        },
        "stem": {
          "$ref": "#/$defs/safeStaticStem"
        }
      }
    },
    "filenamePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "pattern",
        "package_stem",
        "requirement_stems",
        "collision_policy",
        "extension_policy"
      ],
      "properties": {
        "policy_version": {
          "const": 1
        },
        "pattern": {
          "const": "safe_static_stem_with_counter_v1"
        },
        "package_stem": {
          "$ref": "#/$defs/safeStaticStem"
        },
        "requirement_stems": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/requirementStem"
          }
        },
        "collision_policy": {
          "const": "append_counter"
        },
        "extension_policy": {
          "const": "derive_from_output_mode"
        }
      }
    },
    "outputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_version",
        "allowed_modes",
        "default_mode",
        "encryption_policy",
        "flatten_policy",
        "limits",
        "filename_policy"
      ],
      "properties": {
        "output_version": {
          "const": 1
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["combined_pdf", "separate_pdfs", "zip"]
          }
        },
        "default_mode": {
          "enum": ["combined_pdf", "separate_pdfs", "zip"]
        },
        "encryption_policy": {
          "enum": ["must_be_unencrypted", "allowed"]
        },
        "flatten_policy": {
          "enum": ["required", "allowed"]
        },
        "limits": {
          "$ref": "#/$defs/outputLimits"
        },
        "filename_policy": {
          "$ref": "#/$defs/filenamePolicy"
        }
      }
    },
    "packageScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "package"
        }
      }
    },
    "requirementScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requirement_id"],
      "properties": {
        "kind": {
          "const": "requirement"
        },
        "requirement_id": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "messageScope": {
      "oneOf": [
        {
          "$ref": "#/$defs/packageScope"
        },
        {
          "$ref": "#/$defs/requirementScope"
        }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_id", "severity", "message", "scope"],
      "properties": {
        "warning_id": {
          "$ref": "#/$defs/token"
        },
        "severity": {
          "enum": ["information", "needs_review"]
        },
        "message": {
          "$ref": "#/$defs/plainText"
        },
        "scope": {
          "$ref": "#/$defs/messageScope"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_id", "statement", "scope", "actor", "effect"],
      "properties": {
        "confirmation_id": {
          "$ref": "#/$defs/token"
        },
        "statement": {
          "$ref": "#/$defs/plainText"
        },
        "scope": {
          "$ref": "#/$defs/messageScope"
        },
        "actor": {
          "const": "user"
        },
        "effect": {
          "const": "records_review_only"
        }
      }
    }
  }
}
