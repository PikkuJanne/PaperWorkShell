{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperworkshell.local/schemas/m1-vertical-slice-benchmark-report-v1.json",
  "title": "PaperWorkShell Milestone 1 vertical-slice measurement report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version",
    "report_kind",
    "profile_id",
    "scenario_id",
    "measurement_policy",
    "reference_environment",
    "vertical_slice"
  ],
  "properties": {
    "report_schema_version": {
      "const": 1
    },
    "report_kind": {
      "const": "m1-vertical-slice-measurement"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scenario_id": {
      "enum": ["local-smoke", "limited-storage", "rotational-hdd"]
    },
    "measurement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "product_targets"],
      "properties": {
        "status": {
          "const": "record-only"
        },
        "product_targets": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "reference_environment": {
      "$ref": "#/$defs/referenceEnvironment"
    },
    "vertical_slice": {
      "$ref": "#/$defs/verticalSlice"
    }
  },
  "$defs": {
    "scalarObservation": {
      "type": ["integer", "string", "null"],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "versionIdentity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "referenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/scalarObservation"
        },
        "required_maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required_minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed": {
          "$ref": "#/$defs/scalarObservation"
        },
        "attested": {
          "$ref": "#/$defs/scalarObservation"
        },
        "verification": {
          "enum": ["runtime-observation", "operator-attested-allocation", "operator-attested"]
        },
        "status": {
          "enum": ["matched", "mismatched", "unknown"]
        }
      },
      "oneOf": [
        {
          "required": ["required", "observed", "verification", "status"]
        },
        {
          "required": ["required", "attested", "verification", "status"]
        },
        {
          "required": ["required_maximum", "observed", "verification", "status"]
        },
        {
          "required": ["required_minimum", "observed", "verification", "status"]
        }
      ]
    },
    "referenceEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "attestations", "evaluation"],
      "properties": {
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os_family",
            "architecture",
            "logical_processors",
            "memory_bytes",
            "storage_capacity_bytes",
            "storage_free_bytes",
            "graphics",
            "storage_media"
          ],
          "properties": {
            "os_family": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_. -]{1,64}$"
            },
            "architecture": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,64}$"
            },
            "logical_processors": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "memory_bytes": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "storage_capacity_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "storage_free_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "graphics": {
              "type": "null"
            },
            "storage_media": {
              "type": "null"
            }
          }
        },
        "attestations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory_mib", "graphics_class", "storage_media"],
          "properties": {
            "memory_mib": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "graphics_class": {
              "type": ["string", "null"],
              "enum": ["integrated", null]
            },
            "storage_media": {
              "type": ["string", "null"],
              "enum": ["hdd-or-validated-emulation", null]
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "requirements"],
          "properties": {
            "status": {
              "enum": ["not-evaluated", "matched", "mismatched"]
            },
            "requirements": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "os_family": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "architecture": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "logical_processors": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "memory_mib": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "graphics_class": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "storage_capacity_bytes": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "storage_free_bytes": {
                  "$ref": "#/$defs/referenceRequirement"
                },
                "storage_media": {
                  "$ref": "#/$defs/referenceRequirement"
                }
              }
            }
          }
        }
      }
    },
    "phaseMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "outcome", "elapsed_ns"],
      "properties": {
        "phase": {
          "enum": [
            "case-create",
            "pdf-import",
            "thumbnail-render",
            "organize",
            "verified-export",
            "case-reopen-recovery"
          ]
        },
        "outcome": {
          "enum": ["completed", "failed"]
        },
        "elapsed_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "workerResourceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "process_memory_limit_bytes",
        "job_memory_limit_bytes",
        "peak_process_memory_used_bytes",
        "peak_job_memory_used_bytes"
      ],
      "properties": {
        "operation": {
          "enum": ["source-inspection", "thumbnail-render", "verified-export"]
        },
        "process_memory_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "job_memory_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "peak_process_memory_used_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "peak_job_memory_used_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "workspaceUsageMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "case_bytes",
        "cache_bytes",
        "temp_bytes",
        "entry_count",
        "maximum_depth_seen"
      ],
      "properties": {
        "checkpoint": {
          "enum": ["created", "imported", "organized", "exported", "recovered"]
        },
        "case_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "temp_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum_depth_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "completedRunEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "sample_count",
        "repository_revision",
        "repository_tree",
        "repository_worktree_clean",
        "reference_profile_sha256",
        "report_schema_sha256",
        "fixture_set_sha256",
        "source_set_sha256",
        "python_version",
        "pikepdf_version",
        "qpdf_version",
        "pdfium_version",
        "qt_version",
        "worker_config_sha256",
        "renderer_profile_sha256",
        "manifest_schema_version",
        "worker_protocol_version",
        "export_profile_version",
        "workload_version",
        "source_count",
        "source_page_count",
        "active_page_count",
        "preview_count",
        "output_count",
        "output_page_count",
        "output_bytes",
        "output_sha256",
        "semantic_fingerprint",
        "deterministic_semantic_equal",
        "deterministic_output_equal",
        "verifier_codes",
        "recovery_status",
        "case_reopened",
        "reopened_page_count",
        "reopened_sequence_equal",
        "privacy_scan_status",
        "privacy_canary_count",
        "background_export_completed",
        "heartbeat_count",
        "maximum_heartbeat_gap_ns"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sample_count": {
          "const": 1
        },
        "repository_revision": {
          "$ref": "#/$defs/gitObjectId"
        },
        "repository_tree": {
          "$ref": "#/$defs/gitObjectId"
        },
        "repository_worktree_clean": {
          "const": true
        },
        "reference_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fixture_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python_version": {
          "$ref": "#/$defs/versionIdentity"
        },
        "pikepdf_version": {
          "$ref": "#/$defs/versionIdentity"
        },
        "qpdf_version": {
          "$ref": "#/$defs/versionIdentity"
        },
        "pdfium_version": {
          "$ref": "#/$defs/versionIdentity"
        },
        "qt_version": {
          "$ref": "#/$defs/versionIdentity"
        },
        "worker_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "renderer_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "worker_protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "export_profile_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workload_version": {
          "const": 1
        },
        "source_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "source_page_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "active_page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "preview_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "output_count": {
          "const": 2
        },
        "output_page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "deterministic_semantic_equal": {
          "const": true
        },
        "deterministic_output_equal": {
          "const": true
        },
        "verifier_codes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {"const": "PDF_REOPENED"},
            {"const": "STRUCTURE_CLEAN"},
            {"const": "PAGE_COUNT_MATCHED"},
            {"const": "UNENCRYPTED"},
            {"const": "ALL_PAGES_RENDERED"},
            {"const": "ORDER_ROTATION_MATCHED"},
            {"const": "OUTPUT_COMMIT_REOPENED"}
          ],
          "items": false
        },
        "recovery_status": {
          "enum": ["current", "recovered"]
        },
        "case_reopened": {
          "const": true
        },
        "reopened_page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reopened_sequence_equal": {
          "const": true
        },
        "privacy_scan_status": {
          "const": "passed"
        },
        "privacy_canary_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "background_export_completed": {
          "const": true
        },
        "heartbeat_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximum_heartbeat_gap_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verticalSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_status",
        "result_code",
        "phase_measurements",
        "worker_resource_measurements",
        "workspace_usage_measurements"
      ],
      "properties": {
        "run_status": {
          "enum": ["not-run", "completed", "failed"]
        },
        "result_code": {
          "type": ["string", "null"],
          "pattern": "^M1_[A-Z0-9_]{1,96}$"
        },
        "phase_measurements": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/phaseMeasurement"
          }
        },
        "worker_resource_measurements": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/workerResourceMeasurement"
          }
        },
        "workspace_usage_measurements": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/workspaceUsageMeasurement"
          }
        },
        "completed_evidence": {
          "$ref": "#/$defs/completedRunEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"run_status": {"const": "not-run"}},
            "required": ["run_status"]
          },
          "then": {
            "properties": {
              "result_code": {"const": "M1_VERTICAL_SLICE_NOT_RUN"},
              "phase_measurements": {"maxItems": 0},
              "worker_resource_measurements": {"maxItems": 0},
              "workspace_usage_measurements": {"maxItems": 0}
            },
            "not": {"required": ["completed_evidence"]}
          }
        },
        {
          "if": {
            "properties": {"run_status": {"const": "completed"}},
            "required": ["run_status"]
          },
          "then": {
            "required": ["completed_evidence"],
            "properties": {
              "result_code": {"type": "null"},
              "phase_measurements": {"minItems": 6, "maxItems": 6},
              "worker_resource_measurements": {"minItems": 3, "maxItems": 3},
              "workspace_usage_measurements": {"minItems": 5, "maxItems": 5}
            }
          }
        },
        {
          "if": {
            "properties": {"run_status": {"const": "failed"}},
            "required": ["run_status"]
          },
          "then": {
            "properties": {
              "phase_measurements": {"minItems": 1}
            },
            "not": {"required": ["completed_evidence"]}
          }
        }
      ]
    }
  }
}
